# Dependencies
node_modules/

# Build outputs
dist/
build/
*.local

# Environment (never commit secrets)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editor
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# Vite
.vite/

# Testing / coverage
coverage/

# Misc
.cache/
*.pem

# Vercel CLI (local `vercel link` — can contain sensitive ids)
**/.vercel/

